{
  "name": "ccr-vscode",
  "displayName": "CCR - Configuration Switcher",
  "icon": "icon.png",
  "description": "Manage Claude and Codex configurations directly from the VSCode sidebar",
  "version": "5.4.7",
  "publisher": "ccr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bahayonghang/ccr"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other",
    "Configuration"
  ],
  "keywords": [
    "claude",
    "codex",
    "ai",
    "configuration"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ccr",
          "title": "CCR Profiles",
          "icon": "resources/icons/ccr.svg"
        }
      ]
    },
    "views": {
      "ccr": [
        {
          "id": "ccr-profiles",
          "name": "Profiles",
          "icon": "resources/icons/ccr.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "ccr.refreshProfiles",
        "title": "CCR: Refresh Profiles",
        "icon": "$(refresh)"
      },
      {
        "command": "ccr.switchProfile",
        "title": "CCR: Switch Profile"
      },
      {
        "command": "ccr.addProfile",
        "title": "CCR: Add Profile",
        "icon": "$(add)"
      },
      {
        "command": "ccr.addProfileForPlatform",
        "title": "CCR: Add Profile For Platform",
        "icon": "$(add)"
      },
      {
        "command": "ccr.editProfileVisual",
        "title": "CCR: Edit Profile",
        "icon": "$(notebook-edit)"
      },
      {
        "command": "ccr.editProfileField",
        "title": "CCR: Edit Profile Field",
        "icon": "$(edit)"
      },
      {
        "command": "ccr.toggleProfileEnabled",
        "title": "CCR: Toggle Profile Enabled",
        "icon": "$(eye)"
      },
      {
        "command": "ccr.deleteProfile",
        "title": "CCR: Delete Profile",
        "icon": "$(trash)"
      },
      {
        "command": "ccr.switchCodexAuth",
        "title": "CCR: Switch Codex Auth"
      },
      {
        "command": "ccr.editCodexAuth",
        "title": "CCR: Edit Codex Auth",
        "icon": "$(edit)"
      },
      {
        "command": "ccr.deleteCodexAuth",
        "title": "CCR: Delete Codex Auth",
        "icon": "$(trash)"
      },
      {
        "command": "ccr.openProfilesFile",
        "title": "CCR: Open Profiles File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ccr.selectStatusBarPlatform",
        "title": "CCR: Select Status Bar Platform",
        "icon": "$(pin)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ccr.refreshProfiles",
          "when": "view == ccr-profiles",
          "group": "navigation"
        },
        {
          "command": "ccr.addProfile",
          "when": "view == ccr-profiles",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "ccr.switchProfile",
          "when": "view == ccr-profiles && viewItem =~ /^profile/",
          "group": "inline@1"
        },
        {
          "command": "ccr.addProfileForPlatform",
          "when": "view == ccr-profiles && viewItem == platform-create-supported",
          "group": "inline@2"
        },
        {
          "command": "ccr.switchCodexAuth",
          "when": "view == ccr-profiles && viewItem =~ /^codex-auth/",
          "group": "inline@1"
        },
        {
          "command": "ccr.editProfileVisual",
          "when": "view == ccr-profiles && viewItem =~ /^profile/",
          "group": "1_edit@0"
        },
        {
          "command": "ccr.editProfileField",
          "when": "view == ccr-profiles && viewItem =~ /^profile/",
          "group": "1_edit@1"
        },
        {
          "command": "ccr.toggleProfileEnabled",
          "when": "view == ccr-profiles && viewItem =~ /^profile/",
          "group": "1_edit@2"
        },
        {
          "command": "ccr.deleteProfile",
          "when": "view == ccr-profiles && viewItem =~ /^profile/",
          "group": "1_edit@3"
        },
        {
          "command": "ccr.addProfileForPlatform",
          "when": "view == ccr-profiles && viewItem == section-profiles-create-supported",
          "group": "1_edit@0"
        },
        {
          "command": "ccr.editCodexAuth",
          "when": "view == ccr-profiles && viewItem =~ /^codex-auth/",
          "group": "1_edit@0"
        },
        {
          "command": "ccr.deleteCodexAuth",
          "when": "view == ccr-profiles && viewItem =~ /^codex-auth/",
          "group": "1_edit@1"
        },
        {
          "command": "ccr.openProfilesFile",
          "when": "view == ccr-profiles && viewItem =~ /^platform/",
          "group": "2_open@1"
        }
      ]
    },
    "configuration": {
      "title": "CCR",
      "properties": {
        "ccr.confirmBeforeSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Show confirmation dialog before switching profiles"
        },
        "ccr.statusBar.mode": {
          "type": "string",
          "default": "pinned",
          "enum": [
            "pinned",
            "current",
            "hidden"
          ],
          "markdownDescription": "Control the CCR status bar item. `pinned` shows one selected platform, `current` follows the current platform, and `hidden` hides the item."
        },
        "ccr.statusBar.platform": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "claude",
            "codex"
          ],
          "enumItemLabels": [
            "Follow current platform",
            "Claude Code",
            "Codex"
          ],
          "markdownEnumDescriptions": [
            "Leave the pinned target empty and fall back to the current platform.",
            "Pin the CCR status bar to **Claude Code**.",
            "Pin the CCR status bar to **Codex**."
          ],
          "description": "Platform to display when ccr.statusBar.mode is pinned."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --charset=utf8",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --charset=utf8 --watch --sourcemap",
    "package": "npm run build -- --minify --legal-comments=none && vsce package --no-dependencies -o ccr-vscode.vsix",
    "lint": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "smol-toml": "^1.3.0"
  }
}
