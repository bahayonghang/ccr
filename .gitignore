# Rust / Cargo
target/
# GPUI workspace keeps its own rebuildable outputs; Cargo.lock is tracked.
/ccr-desktop/target/
doc/
*.bk

# Coverage / profiling artifacts
*.gcov
*.profraw
!*.profraw.orig
*.lcov
coverage/

# Logs and temporary files
*.log
*.tmp
*.temp
.tmp/

# Python helper script caches
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environment files
.env
.env.local
.env.*.local

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# PowerShell module analysis cache. cargo test cwd is the crate root;
# when tests redirect USERPROFILE without LOCALAPPDATA, pwsh writes
# Microsoft/Windows/PowerShell/ModuleAnalysisCache as a relative path.
**/Microsoft/Windows/PowerShell/

# Editor / IDE files
.vscode/
.idea/
*.swp
*.swo
*~
cmake-build-*/

# AI / agent tooling state
.cursor/
.windsurf/
.claude/
# .codex/ and .omp/ are local, tool-generated install directories and are never
# tracked. The shared skill sources they install from are tracked under
# .github/skills/; `trellis update` and client installs may rewrite anything in
# these directories without dirtying the working tree.
.codex/
.agent/
.agents/
.gemini/
.auto-claude/
.omc/
.omcodex/
.omx/
.serena/
.spec-workflow/
.factory/
.trae/
.kiro/
.workflow/
.opencode/
.antigravitycli/
.impeccable/
.omp/
.grok/
.kimi-code/
# Local skill-installer lock. Shared skill sources stay under .github/skills/.
skills-lock.json



# File-based planning artifacts
task_plan.md
findings.md
progress.md

# Project-local generated directories
openspec/
# ref/ holds external reference repos (aghub/ClaudeBar/skills-hub/…) for local browsing only.
# Their nested CLAUDE.md files must not influence this project — treat as read-only mirrors.
ref/
outputs/
ccr-ui/src-tauri/bin/

# Local learning logs
.learnings/
.understand-anything/
.codegraph/
.planning/
.playwright-mcp/

# Cargo output from one-off task builds. The workspace target/ is already ignored.
/target-task-*/

# Local Trellis screenshots, debug binaries, and bulky generated dumps stay on disk.
# Markdown notes stay tracked.
/.trellis/**/*.png
/.trellis/**/*.jpg
/.trellis/**/*.jpeg
/.trellis/**/*.exe
/.trellis/**/*.pdb
/.trellis/**/*.tgz
/.trellis/**/*.lock

