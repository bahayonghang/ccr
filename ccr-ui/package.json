{
  "name": "ccr-ui-frontend-vue",
  "version": "7.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "vite",
    "icons:generate": "uv run ./scripts/generate_icons.py",
    "icons:ensure": "node ./scripts/ensure-icons.cjs",
    "prebundle": "node ./scripts/warm-vite-deps.mjs",
    "prebuild": "bun run icons:ensure",
    "build": "vite build",
    "prebuild:web": "bun run icons:ensure",
    "build:with-budget": "vite build --sourcemap && bun ./scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "audit:dependencies": "bun ./scripts/audit-dependencies.mjs",
    "docs:audit": "node ./scripts/audit-docs.mjs",
    "lint": "eslint . && bun run lint:style",
    "lint:ci": "eslint . --quiet && bun run lint:style",
    "lint:fix": "eslint . --fix && bun run lint:style:fix",
    "lint:style": "stylelint \"src/**/*.css\"",
    "lint:style:fix": "stylelint \"src/**/*.css\" --fix",
    "type-check": "tsc --noEmit",
    "check:bundle-budget": "bun ./scripts/check-bundle-budget.mjs",
    "check:i18n": "bun ./scripts/check-i18n.mjs",
    "test": "bun run test:i18n && bun run test:smoke",
    "test:i18n": "bun tests/i18n.test.cjs",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "clean": "rm -rf dist src-tauri/target node_modules/.vite",
    "clean:all": "rm -rf dist src-tauri/target node_modules",
    "dev:web": "node ./scripts/dev-web-warm-start.mjs",
    "measure:vite-route": "node ./scripts/measure-vite-route.mjs",
    "build:web": "vite build",
    "prebuild:desktop": "bun run icons:ensure",
    "build:desktop": "bun run build && tauri build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "tauri:check": "cd src-tauri && cargo check",
    "tauri:clippy": "cd src-tauri && cargo clippy",
    "tauri:fmt": "cd src-tauri && cargo fmt",
    "tauri:test": "cd src-tauri && cargo test",
    "check:all": "bun run docs:audit && bun run type-check && bun run lint && bun run test && bun run tauri:check"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@hookform/resolvers": "5.9.1",
    "@iconify-json/solar": "^1.2.5",
    "@iconify/react": "6.0.2",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-virtual": "3.14.10",
    "@tauri-apps/api": "2.11.0",
    "@uiw/react-codemirror": "4.25.11",
    "ansi_up": "^6.0.6",
    "apexcharts": "^5.3.6",
    "dompurify": "^3.4.13",
    "fuse.js": "^7.3.0",
    "i18next": "26.4.0",
    "motion": "13.1.1",
    "react": "19.2.8",
    "react-apexcharts": "2.1.1",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "react-i18next": "17.0.12",
    "react-router": "8.3.0",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "2.11.2",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.23",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "8.2.2",
    "vitest": "^4.1.10"
  }
}
