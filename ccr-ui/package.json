{
  "name": "ccr-ui-frontend",
  "version": "7.3.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite",
    "icons:generate": "uv run ./scripts/generate_icons.py",
    "icons:ensure": "node ./scripts/ensure-icons.cjs",
    "prebundle": "node ./scripts/warm-vite-deps.mjs",
    "prebuild": "bun run icons:ensure",
    "build": "vite build",
    "prebuild:web": "bun run icons:ensure",
    "build:with-budget": "vite build --sourcemap && bun ./scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "audit:dependencies": "bun ./scripts/audit-dependencies.mjs",
    "docs:audit": "node ./scripts/audit-docs.mjs",
    "lint": "eslint . && bun run lint:style",
    "lint:ci": "eslint . --quiet && bun run lint:style && bun run check:style-lines",
    "lint:fix": "eslint . --fix && bun run lint:style:fix",
    "lint:style": "stylelint \"src/**/*.css\"",
    "lint:style:fix": "stylelint \"src/**/*.css\" --fix",
    "type-check": "tsc --noEmit",
    "check:bundle-budget": "bun ./scripts/check-bundle-budget.mjs",
    "check:cycles": "bun ./scripts/check-cycles.mjs",
    "check:arch-boundaries": "bun ./scripts/check-arch-boundaries.mjs",
    "check:style-lines": "bun ./scripts/check-component-style-lines.mjs",
    "check:i18n": "bun ./scripts/check-i18n.mjs",
    "test": "bun run test:i18n && bun run test:smoke",
    "test:i18n": "bun tests/i18n.test.cjs && bun ./scripts/detect-i18n-key-leak.mjs --self-test",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "clean": "rm -rf dist src-tauri/target node_modules/.vite",
    "clean:all": "rm -rf dist src-tauri/target node_modules",
    "dev:web": "node ./scripts/dev-web-warm-start.mjs",
    "measure:vite-route": "node ./scripts/measure-vite-route.mjs",
    "build:web": "vite build",
    "prebuild:desktop": "bun run icons:ensure",
    "build:desktop": "bun run build && tauri build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "tauri:check": "cd src-tauri && cargo check",
    "tauri:clippy": "cd src-tauri && cargo clippy",
    "tauri:fmt": "cd src-tauri && cargo fmt",
    "tauri:test": "cd src-tauri && cargo test",
    "check:all": "bun run docs:audit && bun run type-check && bun run lint && bun run test && bun run tauri:check"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@hookform/resolvers": "5.9.1",
    "@iconify-json/solar": "^1.2.10",
    "@iconify/react": "6.0.2",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-virtual": "3.14.10",
    "@tauri-apps/api": "2.11.1",
    "@uiw/react-codemirror": "4.25.11",
    "ansi_up": "^6.0.6",
    "apexcharts": "^5.3.6",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dompurify": "^3.4.14",
    "fuse.js": "^7.3.0",
    "i18next": "26.4.0",
    "motion": "13.1.1",
    "react": "19.2.8",
    "react-apexcharts": "2.1.1",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-i18next": "17.0.12",
    "react-router": "8.3.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dpdm": "^4.3.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.23",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  }
}
