{
  "name": "ccr-ui-frontend-vue",
  "version": "5.5.2",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "vite",
    "icons:generate": "uv run ./scripts/generate_icons.py",
    "icons:ensure": "node ./scripts/ensure-icons.cjs",
    "prebundle": "vite optimize",
    "prebuild": "bun run icons:ensure",
    "build": "vite build",
    "prebuild:web": "bun run icons:ensure",
    "build:with-budget": "vite build --sourcemap && bun ./scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "lint": "eslint . --fix && bun run lint:style",
    "lint:style": "stylelint \"src/**/*.{css,vue}\" --fix",
    "type-check": "vue-tsc --noEmit",
    "check:bundle-budget": "bun ./scripts/check-bundle-budget.mjs",
    "test": "bun run test:i18n && bun run test:smoke",
    "test:i18n": "bun tests/i18n.test.cjs",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:playwright:snapshots": "node ./scripts/capture-route-snapshots.mjs",
    "clean": "rm -rf dist src-tauri/target node_modules/.vite",
    "clean:all": "rm -rf dist src-tauri/target node_modules",
    "dev:web": "vite --port 5173",
    "build:web": "vite build",
    "prebuild:desktop": "bun run icons:ensure",
    "build:desktop": "bun run build && tauri build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "tauri:check": "cd src-tauri && cargo check",
    "tauri:clippy": "cd src-tauri && cargo clippy",
    "tauri:fmt": "cd src-tauri && cargo fmt",
    "tauri:test": "cd src-tauri && cargo test",
    "check:all": "bun run type-check && bun run lint && bun run test && bun run tauri:check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@iconify-json/solar": "^1.2.5",
    "@iconify/vue": "^5.0.0",
    "@tanstack/vue-virtual": "^3.13.18",
    "@tauri-apps/api": "2.10.1",
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^6.0.0",
    "ansi_up": "^6.0.6",
    "apexcharts": "^5.3.6",
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "isomorphic-dompurify": "^3.0.0",
    "marked": "^17.0.1",
    "pinia": "^2.3.1",
    "tailwindcss": "^3.4.19",
    "vue": "^3.5.26",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4",
    "vue3-apexcharts": "^1.10.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@eslint/js": "^9.39.2",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/vue3-vite": "^10.1.11",
    "@tauri-apps/cli": "2.10.0",
    "@types/node": "^22.19.3",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/eslint-config-typescript": "^14.6.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-plugin-storybook": "^10.1.11",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.58.0",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.1",
    "storybook": "^10.1.11",
    "stylelint": "^17.0.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^7.3.0",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^2.2.12"
  },
  "overrides": {
    "balanced-match": "1.0.2"
  }
}
