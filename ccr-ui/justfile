# 更新依赖
update: update-backend update-frontend
    @echo "✅ 依赖更新完成"

# 更新后端依赖
update-backend:
    @echo "⬆️  更新后端依赖..."
    cd src-tauri && cargo update

# 更新前端依赖
update-frontend:
    @echo "⬆️  更新前端依赖..."
    bun update

