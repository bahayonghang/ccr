# CCR UI Justfile
# 一键安装、构建和启动前后端
# 支持 Windows、Linux、macOS 跨平台

# 🧭 跨平台 Shell 配置
# Windows 使用 PowerShell with UTF-8 encoding
set windows-shell := ["pwsh.exe", "-NoLogo", "-NoProfile", "-Command", "$OutputEncoding = [Console]::OutputEncoding = [System.Text.Encoding]::UTF8;"]

# Unix-like 系统使用 bash
set shell := ["bash", "-cu"]

# 📝 跨平台消息打印函数（使用 printf 比 echo -e 更可移植，减少子进程调用）
# 定义跨平台的消息级别函数
[private]
[no-cd]
msg level message:
    @printf '%b\n' "{{level}}{{message}}"

# 🌍 操作系统检测（供条件判断使用）
is_windows := if os() == "windows" { "true" } else { "false" }
is_macos := if os() == "macos" { "true" } else { "false" }
is_linux := if os() == "linux" { "true" } else { "false" }

# 🔧 端口配置（支持环境变量覆盖）
# 使用高位端口避免与 VS Code Server 等服务冲突
vite_port := env("VITE_PORT", "15173")
backend_port := env("BACKEND_PORT", "48081")

# 默认命令：显示帮助信息
default:
    @just help

# 显示常用命令帮助
help:
