# 完整的 CI 流程（检查 + 测试 + 安全审计 + 构建）
ci: check test ci-security build
    @just _ci-summary-{{os()}}

_ci-summary-linux:
    @echo ""
    @echo "✅ CI 流程完成"
    @echo "   - 后端: cargo check + clippy + test"
    @echo "   - 前端: lint + type-check + test"
    @echo "   - 安全: better-npm-audit"
    @echo "   - 构建: src-tauri release + root dist"

_ci-summary-macos:
    @echo ""
    @echo "✅ CI 流程完成"
    @echo "   - 后端: cargo check + clippy + test"
    @echo "   - 前端: lint + type-check + test"
    @echo "   - 安全: better-npm-audit"
    @echo "   - 构建: src-tauri release + root dist"

_ci-summary-windows:
    @Write-Output ''
    @Write-Output '✅ CI 流程完成'
    @Write-Output '   - 后端: cargo check + clippy + test'
    @Write-Output '   - 前端: lint + type-check + test'
    @Write-Output '   - 安全: better-npm-audit'
    @Write-Output '   - 构建: src-tauri release + root dist'

# CI 安全检查（不阻断 CI）
ci-security:
    @just _ci-security-{{os()}}

_ci-security-linux:
    @echo "🔒 检查安全漏洞..."
    @if [ -f "package-lock.json" ]; then \
        bunx better-npm-audit audit || echo "⚠️  安全检查有警告，但不阻断 CI"; \
    else \
        echo "ℹ️  未检测到 package-lock.json，跳过 better-npm-audit（当前使用 bun.lock）"; \
    fi

_ci-security-macos:
    @echo "🔒 检查安全漏洞..."
    @if [ -f "package-lock.json" ]; then \
        bunx better-npm-audit audit || echo "⚠️  安全检查有警告，但不阻断 CI"; \
    else \
        echo "ℹ️  未检测到 package-lock.json，跳过 better-npm-audit（当前使用 bun.lock）"; \
    fi

_ci-security-windows:
    @Write-Output '🔒 检查安全漏洞...'
    @if (Test-Path 'package-lock.json') { bunx better-npm-audit audit; if (-not $?) { Write-Host '⚠️  安全检查有警告，但不阻断 CI' -ForegroundColor Yellow } } else { Write-Host 'ℹ️  未检测到 package-lock.json，跳过 better-npm-audit（当前使用 bun.lock）' -ForegroundColor Cyan }

