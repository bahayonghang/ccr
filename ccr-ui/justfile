    @echo "🖥️  Tauri 桌面应用:"
    @echo "  just tauri-dev      启动 Tauri 开发模式（桌面应用）"
    @echo "  just tauri-build    构建 Tauri 生产版本"
    @echo "  just tauri-check    检查 Tauri 环境和配置"
    @echo ""
    @echo "单独操作:"
    @echo "  just dev-backend       只启动后端"
    @echo "  just dev-frontend      只启动 Vue 前端"
    @echo "  just dev-react-frontend  只启动 Next.js 前端"
    @echo ""
    @echo "其他:"
    @echo "  just info           显示项目信息"
