    if [ -n "$ACTUAL_VITE_PORT" ] && [ "$ACTUAL_VITE_PORT" != "$VITE_PORT" ]; then
        PORTS+=("$ACTUAL_VITE_PORT")
    fi
    echo "🧹 开始清理开发环境..."
    # 优先使用 PID 文件清理（如果存在）
    if [ -f "$JDIR/.backend.pid" ]; then
        PID=$(cat "$JDIR/.backend.pid")
        if kill -0 "$PID" 2>/dev/null; then
