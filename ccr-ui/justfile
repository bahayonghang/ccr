            kill -9 "$PID" 2>/dev/null || true
        fi
        rm -f "$JDIR/.backend.pid"
    fi
    if [ -f "$JDIR/.frontend.pid" ]; then
        PID=$(cat "$JDIR/.frontend.pid")
        if kill -0 "$PID" 2>/dev/null; then
            echo "  停止前端进程 (PID: $PID)..."
            kill -9 "$PID" 2>/dev/null || true
        fi
        rm -f "$JDIR/.frontend.pid"
    fi
    # 仅清理本项目配置的端口（不使用 pkill 避免误杀）
    if command -v lsof >/dev/null 2>&1; then
        for port in "${PORTS[@]}"; do
            lsof -ti:"$port" 2>/dev/null | xargs kill -9 2>/dev/null || true
        done
    fi
    # 清理缓存目录
    rm -rf "$JDIR/node_modules/.vite" 2>/dev/null || true
    echo "✅ 清理完成"

# 清理开发环境 - Windows
# 优化：仅清理本项目配置的端口，避免误杀其他项目
_dev-clean-windows:
    @powershell -ExecutionPolicy Bypass -Command "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; Write-Host '🧹 开始清理开发环境...' -ForegroundColor Cyan"
    @powershell -ExecutionPolicy Bypass -File scripts/clean_dev.ps1 -BackendPort "{{backend_port}}" -VitePort "{{vite_port}}"
    @powershell -ExecutionPolicy Bypass -Command "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; Write-Host '... 清理前端构建目录...' -ForegroundColor Gray"
    @if (Test-Path 'node_modules/.vite') { Remove-Item -Recurse -Force 'node_modules/.vite' }
    @powershell -ExecutionPolicy Bypass -Command "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; Write-Host '✅ 清理完成' -ForegroundColor Green"

