# ===== 快速开发模式（使用 Release 构建） =====

# 快速开发模式 - 使用预编译的 Release 版本启动（二次启动更快）
dev-fast: dev-clean
    @just _dev-fast-start-{{os()}}

_dev-fast-start-linux:
    @echo "⚡ 快速开发模式（使用 Release 构建）..."
    @echo "📍 后端: http://localhost:{{backend_port}}"
    @echo "📍 前端: 启动中 (实际端口启动后输出)"
    @echo ""
    @just dev-fast-parallel

_dev-fast-start-macos:
    @echo "⚡ 快速开发模式（使用 Release 构建）..."
    @echo "📍 后端: http://localhost:{{backend_port}}"
    @echo "📍 前端: 启动中 (实际端口启动后输出)"
    @echo ""
    @just dev-fast-parallel

_dev-fast-start-windows:
    @Write-Output '⚡ 快速开发模式（使用 Release 构建）...'
    @Write-Output '📍 后端: http://localhost:{{backend_port}}'
    @Write-Output '📍 前端: 启动中 (实际端口启动后输出)'
    @Write-Output ''
    @just dev-fast-parallel

# 快速并行启动（Release 模式）
dev-fast-parallel:
    @just _dev-fast-parallel-{{os()}}

_dev-fast-parallel-linux:
    #!/usr/bin/env bash
    set -e
    JDIR="{{justfile_directory()}}"
    BACKEND_PORT="${BACKEND_PORT:-{{backend_port}}}"
    VITE_PORT="${VITE_PORT:-{{vite_port}}}"
    mkdir -p "$JDIR/logs"
    FRONTEND_PORT_FILE="$JDIR/logs/frontend.port"
    echo "$VITE_PORT" > "$FRONTEND_PORT_FILE"
    trap 'kill $(jobs -p) 2>/dev/null' EXIT
    # 检查是否已有 Release 构建，没有则先构建
    if [ ! -f "$JDIR/src-tauri/target/release/ccr-desktop" ]; then
        echo "🏗️  首次运行，正在构建 Release 版本..."
        cd "$JDIR/src-tauri" && CARGO_INCREMENTAL=1 cargo build --release --timings
        echo "📈 cargo timings: src-tauri/target/cargo-timings/cargo-timing.html"
        echo "✅ Release 构建完成"
    fi
    # 启动后端（直接运行二进制，无需编译）
    cd "$JDIR/src-tauri" && ./target/release/ccr-desktop --port "$BACKEND_PORT" 2>&1 | tee -a "$JDIR/logs/backend-console.log" &
    BACK_PID=$!
    echo "⏳ 等待后端就绪 (http://127.0.0.1:$BACKEND_PORT/health)..."
    for i in $(seq 1 15); do
        if curl -sf "http://127.0.0.1:$BACKEND_PORT/health" >/dev/null 2>&1; then
            echo "✅ 后端就绪"
            break
        fi
        if ! kill -0 $BACK_PID 2>/dev/null; then
            echo "❌ 后端进程已退出"
            exit 1
        fi
        sleep 1
        if [ "$i" -eq 15 ]; then
            echo "❌ 等待后端超时(15s)"
            exit 1
        fi
    done
    # 启动前端
    cd "$JDIR" && bun run dev -- --host 0.0.0.0 --port "$VITE_PORT" 2>&1 | tee -a "$JDIR/logs/frontend.log" | while IFS= read -r line; do
        frontend_port=$(printf '%s\n' "$line" | sed -n 's/.*Local:[[:space:]]*http:\/\/localhost:\([0-9][0-9]*\)\/.*/\1/p')
        if [ -n "$frontend_port" ] && [ "$frontend_port" != "$frontend_port_announced" ]; then
            frontend_port_announced="$frontend_port"
            echo "$frontend_port" > "$FRONTEND_PORT_FILE"
            echo "📍 前端: http://localhost:$frontend_port (Vue 3 + Vite)"
        fi
        printf '%s\n' "$line"
    done &
    wait

_dev-fast-parallel-macos:
    #!/usr/bin/env bash
    set -e
    JDIR="{{justfile_directory()}}"
    BACKEND_PORT="${BACKEND_PORT:-{{backend_port}}}"
    VITE_PORT="${VITE_PORT:-{{vite_port}}}"
    mkdir -p "$JDIR/logs"
    FRONTEND_PORT_FILE="$JDIR/logs/frontend.port"
    echo "$VITE_PORT" > "$FRONTEND_PORT_FILE"
    trap 'kill $(jobs -p) 2>/dev/null' EXIT
    # 检查是否已有 Release 构建，没有则先构建
    if [ ! -f "$JDIR/src-tauri/target/release/ccr-desktop" ]; then
        echo "🏗️  首次运行，正在构建 Release 版本..."
        cd "$JDIR/src-tauri" && CARGO_INCREMENTAL=1 cargo build --release --timings
        echo "📈 cargo timings: src-tauri/target/cargo-timings/cargo-timing.html"
        echo "✅ Release 构建完成"
    fi
    # 启动后端（直接运行二进制，无需编译）
    cd "$JDIR/src-tauri" && ./target/release/ccr-desktop --port "$BACKEND_PORT" 2>&1 | tee -a "$JDIR/logs/backend-console.log" &
    BACK_PID=$!
    echo "⏳ 等待后端就绪 (http://127.0.0.1:$BACKEND_PORT/health)..."
    for i in $(seq 1 15); do
        if curl -sf "http://127.0.0.1:$BACKEND_PORT/health" >/dev/null 2>&1; then
            echo "✅ 后端就绪"
            break
        fi
        if ! kill -0 $BACK_PID 2>/dev/null; then
            echo "❌ 后端进程已退出"
            exit 1
        fi
        sleep 1
        if [ "$i" -eq 15 ]; then
            echo "❌ 等待后端超时(15s)"
            exit 1
        fi
    done
    # 启动前端
    cd "$JDIR" && bun run dev -- --host 0.0.0.0 --port "$VITE_PORT" 2>&1 | tee -a "$JDIR/logs/frontend.log" | while IFS= read -r line; do
        frontend_port=$(printf '%s\n' "$line" | sed -n 's/.*Local:[[:space:]]*http:\/\/localhost:\([0-9][0-9]*\)\/.*/\1/p')
        if [ -n "$frontend_port" ] && [ "$frontend_port" != "$frontend_port_announced" ]; then
            frontend_port_announced="$frontend_port"
            echo "$frontend_port" > "$FRONTEND_PORT_FILE"
            echo "📍 前端: http://localhost:$frontend_port (Vue 3 + Vite)"
        fi
        printf '%s\n' "$line"
    done &
    wait

_dev-fast-parallel-windows:
    @powershell -ExecutionPolicy Bypass -File "{{justfile_directory()}}/scripts/dev-fast-windows.ps1" -RootDir "{{justfile_directory()}}" -BackendPort "{{backend_port}}" -VitePort "{{vite_port}}"

