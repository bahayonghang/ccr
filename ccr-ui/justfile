# 启动 Tauri 开发模式（桌面应用）
tauri-dev: _ensure-frontend-deps
    @just _tauri-dev-{{os()}}

_tauri-dev-linux:
    @echo "🖥️  构建并启动 Tauri 桌面应用..."
    @just tauri-build
    @echo ""
    @echo "🚀 启动 CCR Desktop..."
    ./src-tauri/target/release/ccr-desktop

_tauri-dev-macos:
    @echo "🖥️  构建并启动 Tauri 桌面应用..."
    @just tauri-build
    @echo ""
    @echo "🚀 启动 CCR Desktop..."
    open src-tauri/target/release/bundle/macos/CCR\ Desktop.app

_tauri-dev-windows:
    @Write-Output '🖥️  构建并启动 Tauri 桌面应用...'
    @just tauri-build
    @Write-Output ''
    @Write-Output '🚀 启动 CCR Desktop...'
    @Start-Process -FilePath 'src-tauri\target\release\ccr-desktop.exe'

# 构建 Tauri 生产版本（桌面应用）
tauri-build: _ensure-frontend-deps
    @just _tauri-build-{{os()}}

# 确保前端依赖已安装（内部命令）
_ensure-frontend-deps:
    @just _ensure-frontend-deps-{{os()}}

_ensure-frontend-deps-linux:
    #!/usr/bin/env bash
    if [ ! -d "node_modules" ] || [ ! -d "node_modules/vue-i18n" ]; then
        echo "📦 检测到依赖缺失，正在安装前端依赖..."
        if command -v bun >/dev/null 2>&1; then
            bun install
        else
            npm install
        fi
        echo "✅ 前端依赖安装完成"
    else
        echo "✅ 前端依赖已就绪"
    fi

_ensure-frontend-deps-macos:
    #!/usr/bin/env bash
    if [ ! -d "node_modules" ] || [ ! -d "node_modules/vue-i18n" ]; then
        echo "📦 检测到依赖缺失，正在安装前端依赖..."
        bun install
        echo "✅ 前端依赖安装完成"
    else
        echo "✅ 前端依赖已就绪"
    fi

_ensure-frontend-deps-windows:
    @if (-not (Test-Path 'node_modules') -or -not (Test-Path 'node_modules/vue-i18n')) { Write-Output '📦 检测到依赖缺失，正在安装前端依赖...'; bun install; Write-Output '✅ 前端依赖安装完成' } else { Write-Output '✅ 前端依赖已就绪' }

_tauri-build-linux:
    @echo "🏗️  构建 Tauri 桌面应用（生产版本）..."
    @bun run build
    @CARGO_INCREMENTAL=1 bun run tauri:build
    @echo ""
    @echo "✅ Tauri 构建完成"
    @echo "📦 产物位置: src-tauri/target/release/bundle/"
    @echo "   - .deb (Debian/Ubuntu)"
    @echo "   - .AppImage (通用 Linux)"

_tauri-build-macos:
    @echo "🏗️  构建 Tauri 桌面应用（生产版本）..."
    @bun run build
    @CARGO_INCREMENTAL=1 bun run tauri:build
    @echo ""
    @echo "🧹 清理自动挂载的 DMG..."
    @hdiutil detach "/Volumes/CCR Desktop" 2>/dev/null || true
    @echo ""
    @echo "✅ Tauri 构建完成"
    @echo "📦 产物位置: src-tauri/target/release/bundle/"
    @echo "   - .dmg (安装镜像)"
    @echo "   - .app (应用程序包)"

_tauri-build-windows:
    @Write-Output '🏗️  构建 Tauri 桌面应用（生产版本）...'
    @bun run build
    @$env:CARGO_INCREMENTAL = '1'; bun run tauri:build
    @Write-Output ''
    @Write-Output '✅ Tauri 构建完成'
    @Write-Output '📦 产物位置: src-tauri/target/release/bundle/'
    @Write-Output '   - .msi (安装程序)'
    @Write-Output '   - .exe (可执行文件)'

