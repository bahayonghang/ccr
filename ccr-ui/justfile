# ===== 安装 =====

# 安装所有依赖（前端 + 后端）
install: install-frontend install-backend
    @echo "✅ 所有依赖安装完成"
    @echo "💡 提示：可运行 just quick-start 一键启动开发环境"

# 安装前端依赖
install-frontend:
    @just _install-frontend-{{os()}}

_install-frontend-linux:
    @echo "📦 安装前端依赖..."
    bun install
    @echo "✅ 前端依赖安装完成"

_install-frontend-macos:
    @echo "📦 安装前端依赖..."
    bun install
    @echo "✅ 前端依赖安装完成"

_install-frontend-windows:
    @Write-Output '📦 安装前端依赖...'
    @bun install
    @Write-Output '✅ 前端依赖安装完成'

# 安装后端依赖（构建一次以下载依赖）
install-backend:
    @just _install-backend-{{os()}}

_install-backend-linux:
    @echo "📦 安装后端依赖..."
    cd src-tauri && CARGO_INCREMENTAL=1 cargo build --timings
    @echo "📈 cargo timings: src-tauri/target/cargo-timings/cargo-timing.html"
    @echo "✅ 后端依赖安装完成"

_install-backend-macos:
    @echo "📦 安装后端依赖..."
    cd src-tauri && CARGO_INCREMENTAL=1 cargo build --timings
    @echo "📈 cargo timings: src-tauri/target/cargo-timings/cargo-timing.html"
    @echo "✅ 后端依赖安装完成"

_install-backend-windows:
    @Write-Output '📦 安装后端依赖...'
    @Set-Location src-tauri; $env:CARGO_INCREMENTAL = '1'; cargo build --timings
    @Write-Output '📈 cargo timings: src-tauri/target/cargo-timings/cargo-timing.html'
    @Write-Output '✅ 后端依赖安装完成'

