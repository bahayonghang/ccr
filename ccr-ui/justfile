# ===== 开发 =====

# 启动开发环境（Vue 前端 + 后端）
dev: dev-clean
    @just _dev-start-{{os()}}

# 启动浏览器 Web 预览（仅前端，不启动 Tauri 桌面后端）
dev-web:
    @just _dev-web-{{os()}}

_dev-web-linux:
    @just dev-clean
    @echo "🌐 启动浏览器 Web 开发预览..."
    @echo "📍 前端: http://localhost:{{vite_port}}"
    @echo "🌍 监听地址: 0.0.0.0:{{vite_port}}"
    @echo "💡 提示: 这是浏览器预览模式，不会启动 Tauri 桌面壳"
    @echo "⚠️  依赖 Tauri invoke() 的页面在纯 Web 运行时可能受限"
    @echo ""
    mkdir -p logs
    echo "{{vite_port}}" > logs/frontend.port
    BACKEND_PORT="${BACKEND_PORT:-{{backend_port}}}" bun run dev:web -- --host 0.0.0.0 --strictPort --port "{{vite_port}}"

_dev-web-macos:
    @just dev-clean
    @echo "🌐 启动浏览器 Web 开发预览..."
    @echo "📍 前端: http://localhost:{{vite_port}}"
    @echo "🌍 监听地址: 0.0.0.0:{{vite_port}}"
    @echo "💡 提示: 这是浏览器预览模式，不会启动 Tauri 桌面壳"
    @echo "⚠️  依赖 Tauri invoke() 的页面在纯 Web 运行时可能受限"
    @echo ""
    mkdir -p logs
    echo "{{vite_port}}" > logs/frontend.port
    BACKEND_PORT="${BACKEND_PORT:-{{backend_port}}}" bun run dev:web -- --host 0.0.0.0 --strictPort --port "{{vite_port}}"

_dev-web-windows:
    @powershell -ExecutionPolicy Bypass -File scripts/dev-web-windows.ps1 -RootDir "{{justfile_directory()}}" -BackendPort "{{backend_port}}" -VitePort "{{vite_port}}"

_dev-start-linux:
    @echo "🚀 启动开发环境..."
    @echo "📍 后端: http://localhost:{{backend_port}}"
    @echo "📍 前端: 启动中 (实际端口启动后输出)"
    @echo ""
    @just dev-parallel

_dev-start-macos:
    @echo "🚀 启动开发环境..."
    @echo "📍 后端: http://localhost:{{backend_port}}"
    @echo "📍 前端: 启动中 (实际端口启动后输出)"
    @echo ""
    @just dev-parallel

_dev-start-windows:
    @Write-Output '🚀 启动开发环境...'
    @Write-Output '📍 后端: http://localhost:{{backend_port}}'
    @Write-Output '📍 前端: 启动中 (实际端口启动后输出)'
    @Write-Output ''
    @just dev-parallel

# 并行启动前后端开发服务器（跨平台）
dev-parallel:
    @just _dev-parallel-{{os()}}

# 并行启动前后端开发服务器（跨平台）
# 并行启动 - Unix/Linux/macOS
_dev-parallel-linux:
    #!/usr/bin/env bash
    set -e
    JDIR="{{justfile_directory()}}"
    BACKEND_PORT="${BACKEND_PORT:-{{backend_port}}}"
    VITE_PORT="${VITE_PORT:-{{vite_port}}}"
    mkdir -p "$JDIR/logs"
    FRONTEND_PORT_FILE="$JDIR/logs/frontend.port"
    echo "$VITE_PORT" > "$FRONTEND_PORT_FILE"
    trap 'kill $(jobs -p) 2>/dev/null' EXIT

    # ========== 预编译后端（避免健康检查超时） ==========
    echo "🔧 [Backend] Pre-compiling..."
    cd "$JDIR/src-tauri" && CARGO_INCREMENTAL=1 cargo build --timings
    if [ $? -ne 0 ]; then
      echo "❌ [ERROR] Backend compilation failed"
      exit 1
    fi
    echo "📈 [Backend] cargo timings: src-tauri/target/cargo-timings/cargo-timing.html"
    echo "✅ [Backend] Compilation successful"

    # ========== 启动后端（已预编译，直接运行） ==========
    cd "$JDIR/src-tauri" && cargo run -- --port "$BACKEND_PORT" 2>&1 | tee -a "$JDIR/logs/backend-console.log" &
    BACK_PID=$!

    # ========== 等待后端就绪（固定 30 秒超时） ==========
    echo "⏳ 等待后端就绪 (http://127.0.0.1:$BACKEND_PORT/health)..."
    MAX_WAIT=30
    if command -v curl >/dev/null 2>&1; then
      for i in $(seq 1 $MAX_WAIT); do
        if curl -sf "http://127.0.0.1:$BACKEND_PORT/health" >/dev/null 2>&1; then
          echo "✅ 后端就绪"
          break
        fi
        # 后端进程异常退出则立即失败
        if ! kill -0 $BACK_PID 2>/dev/null; then
          echo "❌ 后端进程已退出，请查看 logs/backend-console.log"
          exit 1
        fi
        sleep 1
        if [ "$i" -eq $MAX_WAIT ]; then
          echo "❌ 等待后端超时(${MAX_WAIT}s)，请检查后端日志"
          exit 1
        fi
      done
    else
      echo "⚠️ 未检测到 curl，固定等待 5 秒后启动前端"
      for i in $(seq 1 5); do
        if ! kill -0 $BACK_PID 2>/dev/null; then
          echo "❌ 后端进程已退出，请查看 logs/backend-console.log"
          exit 1
        fi
        sleep 1
      done
    fi

    # ========== Vite 依赖预打包（noDiscovery 模式，填充 .vite/deps 缓存）==========
    echo "⚡ [Frontend] Pre-bundling Vite dependencies..."
    cd "$JDIR" && bun run prebundle 2>/dev/null || echo "⚠️ [WARN] Vite pre-bundling had warnings (non-fatal)"
    echo "✅ [Frontend] Pre-bundling complete"

    # ========== 启动前端 ==========
    cd "$JDIR" && bun run dev -- --host 0.0.0.0 --port "$VITE_PORT" 2>&1 | tee -a "$JDIR/logs/frontend.log" | while IFS= read -r line; do
      frontend_port=$(printf '%s\n' "$line" | sed -n 's/.*Local:[[:space:]]*http:\/\/localhost:\([0-9][0-9]*\)\/.*/\1/p')
      if [ -n "$frontend_port" ] && [ "$frontend_port" != "$frontend_port_announced" ]; then
        frontend_port_announced="$frontend_port"
        echo "$frontend_port" > "$FRONTEND_PORT_FILE"
        echo "📍 前端: http://localhost:$frontend_port (Vue 3 + Vite)"
      fi
      printf '%s\n' "$line"
    done &
    wait

_dev-parallel-macos:
    #!/usr/bin/env bash
    set -e
    JDIR="{{justfile_directory()}}"
    BACKEND_PORT="${BACKEND_PORT:-{{backend_port}}}"
    VITE_PORT="${VITE_PORT:-{{vite_port}}}"
    mkdir -p "$JDIR/logs"
    FRONTEND_PORT_FILE="$JDIR/logs/frontend.port"
    echo "$VITE_PORT" > "$FRONTEND_PORT_FILE"
    trap 'kill $(jobs -p) 2>/dev/null' EXIT

    # ========== 预编译后端（避免健康检查超时） ==========
    echo "🔧 [Backend] Pre-compiling..."
    cd "$JDIR/src-tauri" && CARGO_INCREMENTAL=1 cargo build --timings
    if [ $? -ne 0 ]; then
      echo "❌ [ERROR] Backend compilation failed"
      exit 1
    fi
    echo "📈 [Backend] cargo timings: src-tauri/target/cargo-timings/cargo-timing.html"
    echo "✅ [Backend] Compilation successful"

    # ========== 启动后端（已预编译，直接运行） ==========
    cd "$JDIR/src-tauri" && cargo run -- --port "$BACKEND_PORT" 2>&1 | tee -a "$JDIR/logs/backend-console.log" &
    BACK_PID=$!

    # ========== 等待后端就绪（固定 30 秒超时） ==========
    echo "⏳ 等待后端就绪 (http://127.0.0.1:$BACKEND_PORT/health)..."
    MAX_WAIT=30
    if command -v curl >/dev/null 2>&1; then
      for i in $(seq 1 $MAX_WAIT); do
        if curl -sf "http://127.0.0.1:$BACKEND_PORT/health" >/dev/null 2>&1; then
          echo "✅ 后端就绪"
          break
        fi
        # 后端进程异常退出则立即失败
        if ! kill -0 $BACK_PID 2>/dev/null; then
          echo "❌ 后端进程已退出，请查看 logs/backend-console.log"
          exit 1
        fi
        sleep 1
        if [ "$i" -eq $MAX_WAIT ]; then
          echo "❌ 等待后端超时(${MAX_WAIT}s)，请检查后端日志"
          exit 1
        fi
      done
    else
      echo "⚠️ 未检测到 curl，固定等待 5 秒后启动前端"
      for i in $(seq 1 5); do
        if ! kill -0 $BACK_PID 2>/dev/null; then
          echo "❌ 后端进程已退出，请查看 logs/backend-console.log"
          exit 1
        fi
        sleep 1
      done
    fi

    # ========== Vite 依赖预打包（noDiscovery 模式，填充 .vite/deps 缓存）==========
    echo "⚡ [Frontend] Pre-bundling Vite dependencies..."
    cd "$JDIR" && bun run prebundle 2>/dev/null || echo "⚠️ [WARN] Vite pre-bundling had warnings (non-fatal)"
    echo "✅ [Frontend] Pre-bundling complete"

    # ========== 启动前端 ==========
    cd "$JDIR" && bun run dev -- --host 0.0.0.0 --port "$VITE_PORT" 2>&1 | tee -a "$JDIR/logs/frontend.log" | while IFS= read -r line; do
      frontend_port=$(printf '%s\n' "$line" | sed -n 's/.*Local:[[:space:]]*http:\/\/localhost:\([0-9][0-9]*\)\/.*/\1/p')
      if [ -n "$frontend_port" ] && [ "$frontend_port" != "$frontend_port_announced" ]; then
        frontend_port_announced="$frontend_port"
        echo "$frontend_port" > "$FRONTEND_PORT_FILE"
        echo "📍 前端: http://localhost:$frontend_port (Vue 3 + Vite)"
      fi
      printf '%s\n' "$line"
    done &
    wait

# 并行启动 - Windows
# ✨ 使用后台作业在当前窗口内并行运行，避免弹出新窗口
_dev-parallel-windows:
    @powershell -ExecutionPolicy Bypass -File "{{justfile_directory()}}/scripts/dev-parallel-windows.ps1" -RootDir "{{justfile_directory()}}" -BackendPort "{{backend_port}}" -VitePort "{{vite_port}}"

# 并行启动 - Unix/Linux/macOS
# 启动前清理（端口 + 缓存 + 残留进程）
dev-clean:
    @just _dev-clean-{{os()}}

# 清理开发环境 - Linux
# 优化：优先使用 PID 文件，仅清理本项目占用的端口，避免误杀其他项目
_dev-clean-linux:
    #!/usr/bin/env bash
    set -e
    JDIR="{{justfile_directory()}}"
    BACKEND_PORT="${BACKEND_PORT:-{{backend_port}}}"
    VITE_PORT="${VITE_PORT:-{{vite_port}}}"
    FRONTEND_PORT_FILE="$JDIR/logs/frontend.port"
    ACTUAL_VITE_PORT=""
    if [ -f "$FRONTEND_PORT_FILE" ]; then
        ACTUAL_VITE_PORT="$(head -n 1 "$FRONTEND_PORT_FILE" | tr -d '\r')"
    fi
    PORTS=("$BACKEND_PORT" "$VITE_PORT")
    if [ -n "$ACTUAL_VITE_PORT" ] && [ "$ACTUAL_VITE_PORT" != "$VITE_PORT" ]; then
        PORTS+=("$ACTUAL_VITE_PORT")
    fi
    echo "🧹 开始清理开发环境..."
    # 优先使用 PID 文件清理（如果存在）
    if [ -f "$JDIR/.backend.pid" ]; then
        PID=$(cat "$JDIR/.backend.pid")
        if kill -0 "$PID" 2>/dev/null; then
            echo "  停止后端进程 (PID: $PID)..."
            kill -9 "$PID" 2>/dev/null || true
        fi
        rm -f "$JDIR/.backend.pid"
    fi
    if [ -f "$JDIR/.frontend.pid" ]; then
        PID=$(cat "$JDIR/.frontend.pid")
        if kill -0 "$PID" 2>/dev/null; then
            echo "  停止前端进程 (PID: $PID)..."
            kill -9 "$PID" 2>/dev/null || true
        fi
        rm -f "$JDIR/.frontend.pid"
    fi
    # 仅清理本项目配置的端口（不使用 pkill 避免误杀）
    if command -v lsof >/dev/null 2>&1; then
        for port in "${PORTS[@]}"; do
            lsof -ti:"$port" 2>/dev/null | xargs -r kill -9 2>/dev/null || true
        done
    fi
    # 清理缓存目录
    rm -rf "$JDIR/node_modules/.vite" 2>/dev/null || true
    echo "✅ 清理完成"

# 清理开发环境 - macOS
# 优化：优先使用 PID 文件，仅清理本项目占用的端口，避免误杀其他项目
_dev-clean-macos:
    #!/usr/bin/env bash
    set -e
    JDIR="{{justfile_directory()}}"
    BACKEND_PORT="${BACKEND_PORT:-{{backend_port}}}"
    VITE_PORT="${VITE_PORT:-{{vite_port}}}"
    FRONTEND_PORT_FILE="$JDIR/logs/frontend.port"
